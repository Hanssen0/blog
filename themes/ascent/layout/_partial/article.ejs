<%
var is_note = !post.title;
var link_name = post.title || strip_html(post.content || '').replace(/\s+/g, ' ').trim();
if (Array.from(link_name).length > 80) link_name = Array.from(link_name).slice(0, 80).join('') + '…';
if (!link_name) link_name = (is_note ? 'thought from ' : 'article from ') + date(post.date, 'MMMM D, YYYY');
%>
<article id="<%= post.layout %>-<%= post.slug %>" class="article article-type-<%= is_note ? 'note' : post.layout %>" itemprop="blogPost" itemscope>
  <div class="article-inner">
      <header class="article-header<%= is_note ? ' note-header' : '' %>">
        <% if (!is_note){ %>
        <%- partial('post/title', {class_name: 'article-title'}) %>
        <% } %>
        <div class="article-meta">
          <% if (index){ %>
          <a class="article-date-link" href="<%- url_for(post.path) %>" aria-label="Open <%= link_name %>">
          <% } %>
          <%- partial('post/date', {class_name: 'article-date', date_format: 'MMMM D, YYYY'}) %>
          <% if (index){ %>
          </a>
          <% } %>
          <% if (theme.word_count){ %>
            × <span class="article-word-count"><%= wordcount(post.content) %> words</span>
            <% if (min2read(post.content) == 1){ %>
            × <span class="article-time-to-read"><%= min2read(post.content) %> minute</span>
            <% } else { %>
            × <span class="article-time-to-read"><%= min2read(post.content) %> minutes</span>
            <% } %>
          <% } %>
        </div>
      </header>
    <div class="article-entry" itemprop="articleBody">
      <% if (post.photos && post.photos.length){ %>
      <div class="article-gallery">
        <div class="article-gallery-photos">
          <% post.photos.forEach(function(photo, i){ %>
            <a class="article-gallery-img" data-fancybox="gallery" href="<%- url_for(photo) %>" rel="gallery_<%= post._id %>">
              <img src="<%- url_for(photo) %>" itemprop="image">
            </a>
          <% }) %>
        </div>
      </div>
      <% } %>
      <% if (post.excerpt && index){ %>
        <%- post.excerpt %>
      <% } else { %>
        <%- post.content %>
      <% } %>
    </div>
    <% if (post.excerpt && index && theme.excerpt_link){ %>
      <div class="article-more-link">
        <a href="<%- url_for(post.path) %>#more" aria-label="Read <%= link_name %>"><%= theme.excerpt_link %></a>
      </div>
    <% } %>
    <% if (!index && ((post.tags && post.tags.length) || (post.categories && post.categories.length))){ %>
    <div class="article-category">
      <% if (post.categories && post.categories.length){ %>
        <b>Categories:</b>
        <%- list_categories(post.categories, {
          show_count: false,
          class: 'article-category',
          style: 'none'
        }) %>
      <% } %>
      <% if ((post.tags && post.tags.length) && (post.categories && post.categories.length)){ %>
        <br/>
      <% } %>
      <% if (post.tags && post.tags.length){ %>
        <b>Tags:</b>
        <%- list_tags(post.tags, {
          show_count: false,
          class: 'article-tag',
          style: 'none'
        }) %>
      <% } %>
    </div>
    <% } %>
    <% if (index && theme.intensedebate.enable && theme.intensedebate.acct){ %>
      <footer class="article-footer">
        <a href="<%- url_for(post.path) %>#idc-container">Comments</a>
      </footer>
    <% } %>
  </div>
</article>
<% if (!index){ %>
  <script>
  {
    const savedTheme = localStorage.getItem('s');
    const darkTheme = savedTheme
      ? savedTheme === '1'
      : window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
    const giscus = document.createElement('script');
    giscus.src = 'https://giscus.app/client.js';
    giscus.async = true;
    giscus.crossOrigin = 'anonymous';
    Object.assign(giscus.dataset, {
      repo: 'Hanssen0/blog',
      repoId: 'R_kgDOLLtMtA',
      category: 'Announcements',
      categoryId: 'DIC_kwDOLLtMtM4C0BCw',
      mapping: 'pathname',
      strict: '1',
      reactionsEnabled: '1',
      emitMetadata: '0',
      inputPosition: 'top',
      theme: darkTheme
        ? 'https://blog.hanssen0.com/css/giscus-dark.css?v=2'
        : 'https://blog.hanssen0.com/css/giscus.css?v=2',
      lang: 'en'
    });
    document.currentScript.after(giscus);
  }
  </script>
  <%- partial('post/nav') %>
<% } %>
<% if (!index && post.comments && theme.intensedebate.enable && theme.intensedebate.acct){ %>
  <script>
  var idcomments_acct = '<%= theme.intensedebate.acct %>';
  var idcomments_post_id;
  var idcomments_post_url;
  </script>
  <span id="IDCommentsPostTitle" style="display:none"></span>
  <script type='text/javascript' src='https://www.intensedebate.com/js/genericCommentWrapperV2.js'></script>
<% } %>
